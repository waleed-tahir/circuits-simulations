* Generated by LTspice 26.1.1 for Windows.
V1 in 0 SINE(0 2 1k) AC 1
X§X1 out in out opamp Aol=100K GBW=10Meg ;§pnba invin)noninvin)out
RL out 0 1k
.tran 0 3m 0 1u
.lib opamp.sub
.param Aol=1Meg GBW=100Meg
.meas tran Vin_pk MAX V(in) FROM 1m TO 3m
.meas tran Vout_pk MAX V(out) FROM 1m TO 3m
.meas tran Gain PARAM Vout_pk/Vin_pk
.meas tran Tracking_Error MAX abs(V(out)-V(in)) FROM 1m TO 3m
.backanno
.end
