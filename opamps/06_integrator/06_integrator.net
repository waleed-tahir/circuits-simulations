* C:\Users\PC\Desktop\circuits_simulations\opamps\06_integrator\06_integrator.asc
* Generated by LTspice 26.1.1 for Windows.
V1 in 0 SINE(0 1 1k)
R1 inv in 10k
C1 out inv 100n ic=0
X§X1 inv 0 out opamp Aol=100K GBW=10Meg ;§pnba invin)noninvin)out
.tran 0 5m 0 1u uic
.lib opamp.sub
.param Aol=1Meg GBW=100Meg
.meas tran Vin_pp PP V(in) FROM 2m TO 5m
.meas tran Vout_pp PP V(out) FROM 2m TO 5m
.meas tran Theo_Gain PARAM 1/(2*3.14159265*1000*0.001)
.meas tran Sim_Gain PARAM (Vout_pp/2)/(Vin_pp/2)
.meas tran Error_Pct PARAM 100*abs(Sim_Gain - Theo_Gain)/Theo_Gain
.backanno
.end
