SHEET 1 880 680
WIRE 80 304 160 304
WIRE 240 304 368 304
WIRE 240 208 240 304
WIRE 240 208 304 208
WIRE 368 208 480 208
WIRE 480 208 480 320
WIRE 432 320 480 320
WIRE 480 320 540 320
FLAG 80 384 0
FLAG 368 336 0
FLAG 80 304 in
FLAG 540 320 out
FLAG 240 304 inv
SYMBOL voltage 80 288 R0
SYMATTR InstName V1
SYMATTR Value SINE(0 1 1k)
SYMBOL res 256 288 R90
SYMATTR InstName R1
SYMATTR Value 10k
SYMBOL cap 368 192 R90
SYMATTR InstName C1
SYMATTR Value 100n
SYMATTR SpiceLine ic=0
SYMBOL OpAmps\\opamp 400 256 R0
SYMATTR InstName X1
TEXT 80 440 Left 2 !.tran 0 5m 0 1u uic
TEXT 80 470 Left 2 !.lib opamp.sub
TEXT 80 500 Left 2 !.param Aol=1Meg GBW=100Meg
TEXT 80 530 Left 2 !.meas tran Vin_pp PP V(in) FROM 2m TO 5m
TEXT 80 560 Left 2 !.meas tran Vout_pp PP V(out) FROM 2m TO 5m
TEXT 80 590 Left 2 !.meas tran Theo_Gain PARAM 1/(2*3.14159265*1000*0.001)
TEXT 80 620 Left 2 !.meas tran Sim_Gain PARAM (Vout_pp/2)/(Vin_pp/2)
TEXT 80 650 Left 2 !.meas tran Error_Pct PARAM 100*abs(Sim_Gain - Theo_Gain)/Theo_Gain
